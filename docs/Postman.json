{
  "info": {
    "name": "Banco RPG - CRUD Etapa 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "jogador_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar jogador de teste",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/jogadores",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Teste Postman\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"jogador_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar jogadores",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/jogadores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Editar jogador de teste",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/jogadores/{{jogador_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Teste atualizado\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Excluir jogador de teste",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/jogadores/{{jogador_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirmar 404",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/jogadores/{{jogador_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Validar nome obrigatório",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/jogadores",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}